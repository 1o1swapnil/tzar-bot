{
  "target": "juice-shop",
  "version": "curated-v1 (Juice Shop v17+)",
  "notes": "Report-level answer key: distinct vulnerabilities a competent web tester should report, mapped from well-known Juice Shop challenges. Not every scoreboard challenge (trivia/OSINT/easter eggs are omitted) — use `benchmark.py solved` for the scoreboard. Endpoint patterns are regexes against finding URLs (path?query#fragment). Run `benchmark.py verify-gt juice-shop` on a new build; entries marked verify=true were curated from memory of the challenge list and should be confirmed on first run.",
  "entries": [
    {"id": "js-sqli-login", "title": "SQL injection in login (authentication bypass)", "classes": ["sqli", "auth-bypass"], "endpoints": ["/rest/user/login"], "severity": "critical"},
    {"id": "js-sqli-search", "title": "SQL injection in product search (UNION data extraction)", "classes": ["sqli"], "endpoints": ["/rest/products/search"], "severity": "critical", "probe": "/rest/products/search?q=apple"},
    {"id": "js-nosqli-reviews", "title": "NoSQL injection in product reviews (manipulation / DoS)", "classes": ["nosqli"], "endpoints": ["/rest/products/.*reviews", "/rest/products/reviews"], "severity": "high", "probe": "/rest/products/1/reviews"},
    {"id": "js-xss-dom-search", "title": "DOM XSS in search", "classes": ["xss-dom"], "endpoints": ["/#/search", "search\\?q="], "severity": "medium"},
    {"id": "js-xss-reflected-track", "title": "Reflected XSS in order tracking", "classes": ["xss-reflected"], "endpoints": ["track-result", "/rest/track-order"], "severity": "medium", "probe": "/rest/track-order/5267-f9cd5882f54c75a3"},
    {"id": "js-xss-stored", "title": "Stored XSS (user e-mail, feedback, product description via API)", "classes": ["xss-stored"], "endpoints": ["/api/Users", "/api/Feedbacks", "/api/Products", "/profile", "/#/administration", "/#/contact"], "severity": "high"},
    {"id": "js-idor-basket", "title": "IDOR: view another user's basket", "classes": ["idor"], "endpoints": ["/rest/basket/\\d+"], "severity": "high", "probe": "/rest/basket/1"},
    {"id": "js-bola-basketitems", "title": "BOLA: add items to another user's basket (parameter pollution)", "classes": ["idor", "mass-assignment"], "endpoints": ["/api/BasketItems"], "severity": "high", "probe": "/api/BasketItems"},
    {"id": "js-forged-review", "title": "Forged product review (author not bound to session)", "classes": ["access-control"], "endpoints": ["/rest/products/\\d+/reviews", "/rest/products/reviews"], "severity": "medium"},
    {"id": "js-forged-feedback", "title": "Forged feedback as another user (UserId)", "classes": ["access-control"], "endpoints": ["/api/Feedbacks"], "severity": "medium", "probe": "/api/Feedbacks"},
    {"id": "js-admin-section", "title": "Administration section reachable / exposed client route", "classes": ["bfla", "access-control"], "endpoints": ["administration"], "severity": "medium"},
    {"id": "js-admin-registration", "title": "Mass assignment: register with role=admin", "classes": ["mass-assignment", "bfla"], "endpoints": ["/api/Users"], "severity": "high"},
    {"id": "js-ftp-exposed", "title": "Exposed /ftp directory with confidential documents and backups", "classes": ["info-disclosure"], "endpoints": ["/ftp"], "severity": "medium", "probe": "/ftp"},
    {"id": "js-null-byte", "title": "Poison null byte bypasses the /ftp file-type allowlist", "classes": ["path-traversal", "access-control"], "endpoints": ["/ftp/.+(%2500|%00)"], "severity": "medium"},
    {"id": "js-metrics", "title": "Prometheus metrics exposed without authentication", "classes": ["info-disclosure"], "endpoints": ["/metrics"], "severity": "low", "probe": "/metrics"},
    {"id": "js-error-handling", "title": "Verbose errors / stack traces disclosed", "classes": ["info-disclosure"], "endpoints": ["/rest/", "/api/"], "severity": "low"},
    {"id": "js-api-docs", "title": "Swagger API documentation exposed", "classes": ["info-disclosure"], "endpoints": ["/api-docs"], "severity": "low", "probe": "/api-docs"},
    {"id": "js-jwt", "title": "JWT weaknesses (unsigned alg:none / forged token accepted)", "classes": ["jwt"], "endpoints": [], "severity": "high"},
    {"id": "js-password-reset", "title": "Password reset via guessable security answers", "classes": ["password-reset"], "endpoints": ["/rest/user/reset-password", "security-question"], "severity": "high"},
    {"id": "js-weak-admin-password", "title": "Weak administrator password", "classes": ["weak-credentials"], "endpoints": ["/rest/user/login"], "severity": "high"},
    {"id": "js-login-bruteforce", "title": "No rate limiting / lockout on login", "classes": ["brute-force"], "endpoints": ["/rest/user/login"], "severity": "medium"},
    {"id": "js-captcha-bypass", "title": "CAPTCHA bypass on feedback (replayable captcha)", "classes": ["captcha"], "endpoints": ["/api/Feedbacks", "/rest/captcha"], "severity": "low", "probe": "/rest/captcha"},
    {"id": "js-open-redirect", "title": "Open redirect (allowlist bypass)", "classes": ["open-redirect"], "endpoints": ["/redirect"], "severity": "medium", "probe": "/redirect?to=https://github.com/juice-shop/juice-shop"},
    {"id": "js-xxe", "title": "XXE via XML file upload", "classes": ["xxe"], "endpoints": ["/file-upload"], "severity": "high"},
    {"id": "js-upload", "title": "File upload type/size restrictions bypassed", "classes": ["file-upload"], "endpoints": ["/file-upload"], "severity": "medium"},
    {"id": "js-ssrf", "title": "SSRF via profile image URL", "classes": ["ssrf"], "endpoints": ["/profile/image/url"], "severity": "high"},
    {"id": "js-deluxe-fraud", "title": "Deluxe membership obtained without payment", "classes": ["business-logic"], "endpoints": ["/rest/deluxe-membership"], "severity": "medium", "probe": "/rest/deluxe-membership"},
    {"id": "js-negative-quantity", "title": "Negative basket quantity / price manipulation", "classes": ["business-logic"], "endpoints": ["/api/BasketItems", "/rest/basket"], "severity": "medium"},
    {"id": "js-csrf-profile", "title": "CSRF on profile username change", "classes": ["csrf"], "endpoints": ["/profile"], "severity": "medium", "verify": true},
    {"id": "js-change-password", "title": "Password change via GET without current password (CSRF-able)", "classes": ["csrf", "broken-auth"], "endpoints": ["/rest/user/change-password"], "severity": "medium", "probe": "/rest/user/change-password"},
    {"id": "js-ssti", "title": "Server-side template injection in profile username", "classes": ["ssti"], "endpoints": ["/profile"], "severity": "critical", "verify": true},
    {"id": "js-b2b-rce", "title": "Insecure deserialization / code execution in B2B order API", "classes": ["deserialization", "code-injection"], "endpoints": ["/b2b/v2/orders"], "severity": "critical"},
    {"id": "js-vulnerable-components", "title": "Vulnerable / outdated third-party components", "classes": ["vulnerable-component"], "endpoints": [], "severity": "medium"}
  ]
}
